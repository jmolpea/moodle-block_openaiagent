{{!
    @template block_openaiagent/message_avatar

    Inner content of the small avatar shown beside an assistant chat bubble.

    Rendered from JavaScript once per chat controller and reused for every
    assistant message. The wrapper element carries aria-hidden, so the icon
    needs no accessible name of its own.

    Context variables required for this template:
    * avatarurl - Optional URL of the configured avatar image; the default
                  sparkle icon is drawn when it is empty.

    Example context (json):
    {
        "avatarurl": ""
    }
}}
{{#avatarurl}}
    <img src="{{avatarurl}}" alt="" class="openaiagent-message-avatar-img">
{{/avatarurl}}
{{^avatarurl}}
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none">
        <path d="M12 2L13.09 8.26L19 6L14.74 10.74L21 12L14.74 13.26L19 18L13.09 15.74L12 22L10.91 15.74L5 18L9.26 13.26L3 12L9.26 10.74L5 6L10.91 8.26L12 2Z" fill="white"/>
    </svg>
{{/avatarurl}}
