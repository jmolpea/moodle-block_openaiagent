      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="date_ix" UNIQUE="false" FIELDS="daterecorded"/>
        <INDEX NAME="course_date_ix" UNIQUE="false" FIELDS="courseid, daterecorded"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="block_openaiagent_supportreq" COMMENT="Support escalation requests raised from the assistant chat">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course the request was raised from"/>
        <FIELD NAME="blockinstanceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0" COMMENT="Owning block instance id (0 = course-wide default / legacy)"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Participant who raised the request"/>
        <FIELD NAME="conversationid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0" COMMENT="Conversation the request came from, for the transcript"/>
        <FIELD NAME="category" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" DEFAULT="otro" COMMENT="tecnico|academico|acceso|evaluacion|otro"/>
        <FIELD NAME="summary" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Incident summary drafted by the model. Never contains personal data beyond what the participant typed"/>
        <FIELD NAME="summaryhash" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="SHA-1 of the normalized summary, for deduplication"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" DEFAULT="draft" COMMENT="draft|queued|sent|failed|cancelled|expired"/>
        <FIELD NAME="token" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Single-use confirmation token"/>
        <FIELD NAME="tokenexpiry" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0" COMMENT="Token expiry timestamp"/>
        <FIELD NAME="ticketref" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="Human-readable reference shown to the participant (OA-courseid-id)"/>
        <FIELD NAME="recipients" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Addresses actually used at send time, for auditing"/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="5" NOTNULL="true" SEQUENCE="false" DEFAULT="0" COMMENT="Delivery attempts made so far"/>
        <FIELD NAME="errormsg" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Last delivery error"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
        <FIELD NAME="timesent" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0" COMMENT="When the mailer accepted the message (not proof of delivery)"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="token_ix" UNIQUE="false" FIELDS="token" COMMENT="Confirmation token lookup. Deliberately not unique: the token is random and single use is enforced by status, so blanking a consumed token must not risk a collision"/>
        <INDEX NAME="user_course_time_ix" UNIQUE="false" FIELDS="userid, courseid, timecreated" COMMENT="Per-user quota and cooldown windows"/>
        <INDEX NAME="course_time_ix" UNIQUE="false" FIELDS="courseid, timecreated" COMMENT="Per-course ceiling and circuit breaker"/>
        <INDEX NAME="status_ix" UNIQUE="false" FIELDS="status" COMMENT="Digest batching and expiry purge"/>
        <INDEX NAME="hash_user_ix" UNIQUE="false" FIELDS="summaryhash, userid" COMMENT="Deduplication of repeated requests"/>
        <INDEX NAME="conversation_ix" UNIQUE="false" FIELDS="conversationid" COMMENT="Pending-draft check and in-chat status"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
